# Puerto local de n8n
N8N_PORT=5678
N8N_HOST=127.0.0.1
N8N_PROTOCOL=http
N8N_LISTEN_ADDRESS=127.0.0.1

# Auth (setup owner en la 1ª visita del editor; basic auth legacy)
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=yoryo
N8N_BASIC_AUTH_PASSWORD=cambia-esto-ya

# Datos locales (no van a git)
N8N_USER_FOLDER=./data

# Tras el tunnel, poné la URL pública:
# N8N_EDITOR_BASE_URL=https://xxxx.trycloudflare.com
# WEBHOOK_URL=https://xxxx.trycloudflare.com/
N8N_PROXY_HOPS=1
DB_SQLITE_POOL_SIZE=2
N8N_RUNNERS_ENABLED=true
N8N_GIT_NODE_DISABLE_BARE_REPOS=true

# Sin telemetría
N8N_DIAGNOSTICS_ENABLED=false
N8N_PERSONALIZATION_ENABLED=false
N8N_VERSION_NOTIFICATIONS_ENABLED=false
