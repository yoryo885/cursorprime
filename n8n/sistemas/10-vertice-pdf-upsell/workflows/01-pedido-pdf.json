      "parameters": {
        "jsCode": "const b = $json.body || $json;\nconst catalogo = {\n  'pareto-psicopedagogas': { titulo: 'Pareto para psicopedagogas', rol: 'psicopedagogas', libro: 'pareto' },\n  'habitos-docentes': { titulo: 'Hábitos para docentes', rol: 'docentes', libro: 'habitos' },\n};\nconst slug = String(b.slug || b.sku || '').trim();\nconst email = String(b.email || '').trim();\nconst item = catalogo[slug];\nif (!item) {\n  return [{ json: { ok: false, error: 'slug desconocido', slugs: Object.keys(catalogo), sin_api: true } }];\n}\nreturn [{ json: {\n  ok: true, sistema: '10-vertice-pdf-upsell', etapa: 'pedido_pdf', sin_api: true,\n  orderId: `ORD-${Date.now()}`, slug, email, pdf: item,\n  brief_cursor: { slug, titulo: item.titulo, rol: item.rol, libro: item.libro, accion: 'generar_o_entregar_pdf' },\n  siguiente: 'oferta_upsell',\n  todo: 'SIN API: mock OK. Después: Shopify webhook + pipeline Cursor',\n  at: new Date().toISOString()\n}}];"
      },
