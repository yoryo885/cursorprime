    {
      "parameters": {
        "jsCode": "const b = $json.body || $json;\nconst planesOk = new Set(['basico', 'presencia', 'completo']);\nconst plan = String(b.plan || '').trim().toLowerCase();\nconst cliente = String(b.cliente || b.slug || '').trim();\nconst nombre = String(b.nombre || '').trim();\nconst whatsapp = String(b.whatsapp || b.telefono || '').trim();\nconst jobAudit = String(b.jobId || b.job_audit || '').trim();\nif (!planesOk.has(plan)) {\n  return [{ json: { ok: false, error: 'plan inválido', planes: [...planesOk], sistema: '06-auditorias-locales' } }];\n}\nif (!cliente && !whatsapp) {\n  return [{ json: { ok: false, error: 'falta cliente o whatsapp' } }];\n}\nreturn [{ json: {\n  ok: true,\n  sistema: '06-auditorias-locales',\n  etapa: 'upsell_plan',\n  leadId: `LP-${Date.now()}`,\n  plan,\n  cliente,\n  nombre,\n  whatsapp,\n  jobAudit,\n  status: 'interes_registrado',\n  todo: 'TODO: avisar por Wasap + crear carpeta clientes/{slug}/proyectos/…',\n  at: new Date().toISOString()\n}}];"
      },
      "id": "code-06b",
      "name": "Validar plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        280,
        0
