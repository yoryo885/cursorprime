      "parameters": {
        "jsCode": "const b = $json.body || $json;\nconst to = String(b.whatsapp || b.to || '').trim();\nconst cliente = String(b.cliente || '').trim();\nconst plantilla = String(b.plantilla || 'post_audit').trim();\nconst mensajes = {\n  post_audit: `Hola${cliente ? ' — ' + cliente : ''}: ya tenés el informe de auditoría. Si querés, te paso los planes Básico / Presencia / Completo.`,\n  oferta_plan: `Te dejo los planes: Básico (quick wins), Presencia (web+GBP), Completo (+Wasap). ¿Cuál te sirve?`,\n  cierre: `Cuando quieras avanzamos con el plan que elijas. Sin compromiso en la auditoría.`\n};\nconst texto = mensajes[plantilla] || mensajes.post_audit;\nif (!to) {\n  return [{ json: { ok: false, error: 'falta whatsapp', texto } }];\n}\nreturn [{ json: {\n  ok: true,\n  sistema: '06-auditorias-locales',\n  etapa: 'seguimiento',\n  to,\n  plantilla,\n  texto,\n  status: 'draft_ready',\n  todo: 'TODO_CREDENCIAL: enviar vía Meta Cloud API / proveedor Wasap',\n  at: new Date().toISOString()\n}}];"
      },
