        "jsCode": "const b = $json.body || $json;\nconst url = String(b.url || '').trim();\nconst cliente = String(b.cliente || b.slug || '').trim() || 'sin-slug';\nconst contacto = String(b.whatsapp || b.telefono || b.email || '').trim();\nconst modo = String(b.modo || 'piloto').trim(); // piloto | cobrado\nif (!/^https?:\\/\\//i.test(url)) {\n  return [{ json: { ok: false, error: 'url inválida', sistema: '06-auditorias-locales' } }];\n}\nconst jobId = `AUD-${Date.now()}`;\nreturn [{ json: {\n  ok: true,\n  sistema: '06-auditorias-locales',\n  etapa: 'audit_entrada',\n  jobId,\n  url,\n  cliente,\n  contacto,\n  modo,\n  status: 'queued',\n  entregable_esperado: ['MARKETING-AUDIT.md', 'MARKETING-AUDIT.html'],\n  siguiente: 'enviar_informe_luego_ofrecer_plan',\n  todo: 'TODO_CREDENCIAL: HTTP → marketing_audit_main.py audit --url … --slug …',\n  at: new Date().toISOString()\n}}];"
      },
