        "jsCode": "const b = $json.body || $json;\nconst jobId = String(b.jobId || '').trim();\nconst slug = String(b.slug || '').trim();\nconst checks = {\n  nombre_correcto: !!b.nombre_correcto,\n  categoria: !!b.categoria,\n  horarios: !!b.horarios,\n  telefono_wasap: !!b.telefono_wasap,\n  fotos: !!b.fotos,\n  link_web: !!b.link_web,\n};\nconst done = Object.values(checks).filter(Boolean).length;\nconst total = Object.keys(checks).length;\nconst ok = done === total;\nreturn [{ json: {\n  ok: true,\n  sistema: '07-presencia-digital',\n  etapa: 'gbp',\n  jobId,\n  slug,\n  checks,\n  progreso: `${done}/${total}`,\n  status: ok ? 'gbp_completo' : 'gbp_pendiente',\n  todo: 'TODO: checklist manual o API GBP',\n  at: new Date().toISOString()\n}}];"
      },
