        "jsCode": "const b = $json.body || $json;\nconst to = String(b.whatsapp || b.to || '').trim();\nconst marca = String(b.marca || b.cliente || '').trim();\nconst landingUrl = String(b.landingUrl || '').trim();\nconst paquete = String(b.paquete || 'presencia').trim();\nconst texto = [\n  `Listo${marca ? ' — ' + marca : ''}: tu presencia digital quedó armada.`,\n  landingUrl ? `Web: ${landingUrl}` : 'Web: (pegar URL)',\n  'Google Business: revisá nombre, horarios y link a la web.',\n  paquete === 'completo' ? 'Wasap task: activado / en configuración.' : '',\n  'Si querés cambios chicos, podemos sumar mantenimiento mensual.'\n].filter(Boolean).join('\\n');\nif (!to) {\n  return [{ json: { ok: false, error: 'falta whatsapp', texto } }];\n}\nreturn [{ json: {\n  ok: true,\n  sistema: '07-presencia-digital',\n  etapa: 'entrega',\n  to,\n  texto,\n  status: 'draft_ready',\n  todo: 'TODO_CREDENCIAL: enviar Wasap',\n  at: new Date().toISOString()\n}}];"
      },
