      "parameters": {
        "jsCode": "const b = $json.body || $json;\nconst paquetes = new Set(['presencia', 'completo', 'mantenimiento']);\nconst paquete = String(b.paquete || b.plan || 'presencia').trim().toLowerCase();\nconst cliente = String(b.cliente || b.slug || '').trim();\nconst marca = String(b.marca || b.nombre_negocio || '').trim();\nconst whatsapp = String(b.whatsapp || '').trim();\nconst jobAudit = String(b.jobAudit || b.job_audit || '').trim();\nconst urlNegocio = String(b.url || '').trim();\nif (!paquetes.has(paquete)) {\n  return [{ json: { ok: false, error: 'paquete inválido', paquetes: [...paquetes] } }];\n}\nif (!cliente && !marca) {\n  return [{ json: { ok: false, error: 'falta cliente o marca' } }];\n}\nconst slug = (cliente || marca).toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');\nreturn [{ json: {\n  ok: true,\n  sistema: '07-presencia-digital',\n  etapa: 'alta',\n  jobId: `PRE-${Date.now()}`,\n  slug,\n  marca: marca || slug,\n  paquete,\n  whatsapp,\n  jobAudit,\n  urlNegocio,\n  status: 'queued',\n  apps: ['creador-de-landings', 'vercel/netlify', 'gbp', 'whatsapp', 'clientes/'],\n  entregables: paquete === 'completo'\n    ? ['landing_url', 'gbp_ok', 'wasap_task']\n    : ['landing_url', 'gbp_ok'],\n  todo: 'TODO: crear clientes/{slug}/ + disparar landing pipeline',\n  at: new Date().toISOString()\n}}];"
      },
