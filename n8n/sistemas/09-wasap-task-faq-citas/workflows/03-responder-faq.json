        "jsCode": "const b = $json.body || $json;\nconst text = String(b.text || '').toLowerCase();\nconst from = String(b.from || '').trim();\nconst faqs = b.faqs || {\n  horario: 'Atendemos lun–vie 9 a 18 hs.',\n  precio: 'Te paso la lista de precios por este chat.',\n  direccion: 'Estamos en el centro — pedime el mapa si querés.',\n  servicios: 'Contame qué necesitás y te digo si lo cubrimos.'\n};\nlet key = 'servicios';\nlet reply = faqs.servicios;\nfor (const k of Object.keys(faqs)) {\n  if (text.includes(k) || (k === 'direccion' && (text.includes('dirección') || text.includes('donde')))) {\n    key = k; reply = faqs[k]; break;\n  }\n}\nreturn [{ json: {\n  ok: true,\n  sistema: '09-wasap-task-faq-citas',\n  etapa: 'faq',\n  from, key, reply,\n  status: 'draft_ready',\n  todo: 'TODO_CREDENCIAL: send Wasap + faq por cliente',\n  at: new Date().toISOString()\n}}];"
      },
