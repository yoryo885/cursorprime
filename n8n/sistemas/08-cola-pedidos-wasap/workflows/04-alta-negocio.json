        "jsCode": "const b = $json.body || $json;\nconst paquetes = new Set(['setup', 'mensual', 'pico']);\nconst paquete = String(b.paquete || 'setup').trim().toLowerCase();\nconst marca = String(b.marca || b.nombre || '').trim();\nconst whatsapp = String(b.whatsapp || '').trim();\nconst rubro = String(b.rubro || 'local').trim();\nif (!paquetes.has(paquete)) return [{ json: { ok: false, error: 'paquete inválido', paquetes: [...paquetes] } }];\nif (!marca) return [{ json: { ok: false, error: 'falta marca' } }];\nconst slug = marca.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '');\nreturn [{ json: {\n  ok: true,\n  sistema: '08-cola-pedidos-wasap',\n  etapa: 'alta_negocio',\n  jobId: `COL-${Date.now()}`,\n  slug, marca, rubro, whatsapp, paquete,\n  status: 'onboarding',\n  apps: ['whatsapp-meta', 'n8n', 'sheet/notion'],\n  todo: 'TODO: clientes/{slug}/ + activar webhooks Meta',\n  at: new Date().toISOString()\n}}];"
      },
