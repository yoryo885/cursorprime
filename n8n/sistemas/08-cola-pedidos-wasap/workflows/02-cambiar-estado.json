      "parameters": {
        "jsCode": "const b = $json.body || $json;\nconst okEstados = new Set(['nuevo', 'preparando', 'listo', 'entregado', 'cancelado']);\nconst ticket = String(b.ticket || '').trim();\nconst estado = String(b.estado || '').trim().toLowerCase();\nconst negocio = String(b.negocio || '').trim();\nif (!ticket) return [{ json: { ok: false, error: 'falta ticket' } }];\nif (!okEstados.has(estado)) return [{ json: { ok: false, error: 'estado inválido', okEstados: [...okEstados] } }];\nreturn [{ json: {\n  ok: true,\n  sistema: '08-cola-pedidos-wasap',\n  etapa: 'cambio_estado',\n  ticket,\n  negocio,\n  estado,\n  status: 'actualizado',\n  siguiente: estado === 'listo' ? 'avisar_cliente' : null,\n  todo: 'TODO: update fila Sheet + trigger 08c si listo',\n  at: new Date().toISOString()\n}}];"
      },
