        "jsCode": "const b = $json.body || $json;\nconst to = String(b.whatsapp || b.to || '').trim();\nconst ticket = String(b.ticket || '').trim();\nconst estado = String(b.estado || 'listo').trim();\nconst negocio = String(b.negocio || '').trim();\nconst msgs = {\n  nuevo: `Pedido ${ticket} recibido${negocio ? ' en ' + negocio : ''}. Te avisamos cuando esté listo.`,\n  preparando: `Pedido ${ticket}: lo estamos preparando.`,\n  listo: `Pedido ${ticket}: ¡listo! Ya podés pasar / te lo enviamos.`,\n  entregado: `Pedido ${ticket}: marcado como entregado. Gracias.`,\n  cancelado: `Pedido ${ticket}: cancelado. Si fue un error, escribinos.`\n};\nconst texto = msgs[estado] || msgs.listo;\nif (!to) return [{ json: { ok: false, error: 'falta whatsapp', texto } }];\nreturn [{ json: {\n  ok: true,\n  sistema: '08-cola-pedidos-wasap',\n  etapa: 'aviso',\n  to, ticket, estado, texto,\n  status: 'draft_ready',\n  todo: 'TODO_CREDENCIAL: Meta Cloud API send message',\n  at: new Date().toISOString()\n}}];"
      },
