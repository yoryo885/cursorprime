<section class="vp-main-page" style="text-align:center;max-width:480px">
  <h1>{{ shop.name }}</h1>
  <p style="color:var(--vp-muted);margin-bottom:24px">Tienda en preparación. Introduce la contraseña para acceder.</p>
  {% form 'storefront_password' %}
    {{ form.errors | default_errors }}
    <input type="password" name="password" placeholder="Contraseña" style="width:100%;padding:12px 16px;border:1px solid var(--vp-border);margin-bottom:12px;font-family:inherit"/>
    <button type="submit" class="vp-btn vp-btn-full">Entrar</button>
  {% endform %}
</section>
{% schema %}
{
  "name": "Contraseña tienda",
  "settings": [],
  "templates": ["password"]
}
{% endschema %}
