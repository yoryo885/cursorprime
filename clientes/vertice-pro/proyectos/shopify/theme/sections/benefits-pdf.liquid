<section class="vp-section" id="beneficios">
  <h2>{{ section.settings.heading | default: "Qué incluye cada guía" }}</h2>
  <div class="vp-benefits">
    <div class="vp-benefit">
      <h3>Plan de 10 semanas</h3>
      <p>Una acción concreta por semana, sin teoría de más.</p>
    </div>
    <div class="vp-benefit">
      <h3>Adaptado a tu rol</h3>
      <p>No es un resumen genérico: está pensado para tu oficio.</p>
    </div>
    <div class="vp-benefit">
      <h3>Descarga al instante</h3>
      <p>Compras, descargas y empiezas hoy en celular o tablet.</p>
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Beneficios",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Qué incluye cada guía" }
  ]
}
{% endschema %}
