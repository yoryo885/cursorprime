<section class="vp-hero">
  <div class="vp-wrap">
    <div class="vp-hero-copy">
      <p class="vp-hero-label">{{ section.settings.label | default: "Nuevo · Serie Aplicar en tu rol" }}</p>
      <h1>{{ section.settings.heading | default: "Guías que aplicas esta semana" }}</h1>
      <p class="vp-hero-desc">{{ section.settings.subheading | default: "Guías PDF en español para profesionales ocupados" }}</p>
      <a href="{{ section.settings.button_link | default: '#guias' }}" class="vp-btn">{{ section.settings.button_label | default: "Ver colección" }}</a>
    </div>
    <div class="vp-hero-visual">
      <div class="vp-carousel" id="vpHeroCarousel" data-interval="{{ section.settings.autoplay_seconds | default: 5 | times: 1000 }}">
        <div class="vp-carousel-track">
          {% for block in section.blocks %}
            {% assign asset_key = block.settings.asset_file | default: 'portada-pareto.png' %}
            {% assign cover_url = block.settings.cover | image_url: width: 560 %}
            {% if block.settings.cover == blank %}
              {% assign cover_url = asset_key | asset_url %}
            {% endif %}
            <figure
              class="vp-carousel-slide{% if forloop.first %} is-active{% endif %}{% unless block.settings.available %} is-soon{% endunless %}"
              data-index="{{ forloop.index0 }}"
              data-title="{{ block.settings.title | escape }}"
              data-price="{{ block.settings.price | escape }}"
              {{ block.shopify_attributes }}
            >
              <img src="{{ cover_url }}" alt="{{ block.settings.title | escape }}" draggable="false" loading="{% if forloop.first %}eager{% else %}lazy{% endif %}" width="280" height="360"/>
            </figure>
          {% endfor %}
        </div>
      </div>
      {% if section.blocks.size > 1 %}
        <div class="vp-carousel-nav">
          <button type="button" class="vp-carousel-btn" data-carousel-prev aria-label="Anterior">‹</button>
          <div class="vp-carousel-dots">
            {% for block in section.blocks %}
              <button type="button" class="vp-carousel-dot{% if forloop.first %} is-active{% endif %}" data-index="{{ forloop.index0 }}" aria-label="Guía {{ forloop.index }}"></button>
            {% endfor %}
          </div>
          <button type="button" class="vp-carousel-btn" data-carousel-next aria-label="Siguiente">›</button>
        </div>
      {% endif %}
      <div class="vp-carousel-caption" id="vpCarouselCaption">
        <span class="vp-carousel-badge">{{ section.settings.serie_label | default: "Serie Aplicar en tu rol" }}</span>
        {% assign first = section.blocks.first %}
        <strong id="vpCaptionTitle">{% if first %}{{ first.settings.title }}{% endif %}</strong>
        <span id="vpCaptionPrice">{% if first %}{{ first.settings.price }}{% endif %}</span>
      </div>
    </div>
  </div>
</section>

<script>
(function() {
  var root = document.getElementById('vpHeroCarousel');
  if (!root) return;
  var slides = root.querySelectorAll('.vp-carousel-slide');
  if (slides.length < 2) return;
  var dots = document.querySelectorAll('.vp-carousel-dot');
  var titleEl = document.getElementById('vpCaptionTitle');
  var priceEl = document.getElementById('vpCaptionPrice');
  var idx = 0;
  var timer;
  var touchX = 0;
  var interval = parseInt(root.dataset.interval || '4500', 10);

  function show(i) {
    idx = (i + slides.length) % slides.length;
    slides.forEach(function(s, n) { s.classList.toggle('is-active', n === idx); });
    dots.forEach(function(d, n) { d.classList.toggle('is-active', n === idx); });
    var s = slides[idx];
    if (titleEl) titleEl.textContent = s.dataset.title || '';
    if (priceEl) priceEl.textContent = s.dataset.price || '';
  }
  function next() { show(idx + 1); }
  function prev() { show(idx - 1); }
  function resetTimer() {
    clearInterval(timer);
    timer = setInterval(next, interval);
  }
  document.querySelector('[data-carousel-next]')?.addEventListener('click', function() { next(); resetTimer(); });
  document.querySelector('[data-carousel-prev]')?.addEventListener('click', function() { prev(); resetTimer(); });
  dots.forEach(function(d) {
    d.addEventListener('click', function() { show(+d.dataset.index); resetTimer(); });
  });
  root.addEventListener('touchstart', function(e) { touchX = e.touches[0].clientX; }, { passive: true });
  root.addEventListener('touchend', function(e) {
    var dx = e.changedTouches[0].clientX - touchX;
    if (Math.abs(dx) > 40) { dx < 0 ? next() : prev(); resetTimer(); }
  }, { passive: true });
  resetTimer();
})();
</script>

{% schema %}
{
  "name": "Hero PDF",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "label", "label": "Etiqueta", "default": "Nuevo · Serie Aplicar en tu rol" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Guías que aplicas esta semana" },
    { "type": "textarea", "id": "subheading", "label": "Subtítulo", "default": "Guías PDF en español para profesionales ocupados" },
    { "type": "text", "id": "button_label", "label": "Botón", "default": "Ver colección" },
    { "type": "url", "id": "button_link", "label": "Enlace botón", "default": "/collections/all" },
    { "type": "text", "id": "serie_label", "label": "Etiqueta serie", "default": "Serie Aplicar en tu rol" },
    { "type": "range", "id": "autoplay_seconds", "min": 3, "max": 10, "step": 1, "unit": "s", "label": "Auto-rotación", "default": 5 }
  ],
  "blocks": [
    {
      "type": "guide",
      "name": "Guía",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Guía PDF" },
        { "type": "text", "id": "price", "label": "Precio", "default": "$4.99" },
        { "type": "checkbox", "id": "available", "label": "Disponible", "default": true },
        { "type": "image_picker", "id": "cover", "label": "Portada (opcional)" },
        {
          "type": "select",
          "id": "asset_file",
          "label": "Portada por defecto",
          "options": [
            { "value": "portada-pareto.png", "label": "Pareto — portada PDF (foto)" },
            { "value": "portada-pareto.svg", "label": "Pareto — mock crema" },
            { "value": "portada-kahneman-docentes.svg", "label": "Kahneman docentes" },
            { "value": "portada-habitos-enfermeras.svg", "label": "Hábitos enfermeras" },
            { "value": "portada-producto.svg", "label": "Genérica" }
          ],
          "default": "portada-pareto.svg"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero PDF",
      "blocks": [
        {
          "type": "guide",
          "settings": {
            "title": "Pareto para psicopedagogas en 10 semanas",
            "price": "$4.99",
            "available": true,
            "asset_file": "portada-pareto.png"
          }
        },
        {
          "type": "guide",
          "settings": {
            "title": "Kahneman para docentes en 10 semanas",
            "price": "$4.99",
            "available": false,
            "asset_file": "portada-kahneman-docentes.svg"
          }
        },
        {
          "type": "guide",
          "settings": {
            "title": "Hábitos atómicos para enfermeras en 10 semanas",
            "price": "$4.99",
            "available": false,
            "asset_file": "portada-habitos-enfermeras.svg"
          }
        }
      ]
    }
  ]
}
{% endschema %}
