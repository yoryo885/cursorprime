<section class="vp-section" id="opiniones">
  <div class="vp-wrap">
    <h2>{{ section.settings.heading | default: "Lo que dicen" }}</h2>
    <div class="vp-reviews">
      {% for block in section.blocks %}
        <blockquote class="vp-review" {{ block.shopify_attributes }}>
          <p>«{{ block.settings.quote }}»</p>
          <cite>— {{ block.settings.author }}</cite>
        </blockquote>
      {% endfor %}
    </div>
  </div>
</section>
{% schema %}
{
  "name": "Opiniones",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Lo que dicen" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Opinión",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Cita", "default": "Me ayudó a priorizar casos en el gabinete." },
        { "type": "text", "id": "author", "label": "Nombre", "default": "María" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Opiniones",
      "blocks": [
        { "type": "review", "settings": { "quote": "Me ayudó a priorizar casos en el gabinete.", "author": "María" } },
        { "type": "review", "settings": { "quote": "Descarga al instante y plan de 10 semanas claro.", "author": "Carolina" } },
        { "type": "review", "settings": { "quote": "Resumen adaptado a psicopedagogas, no genérico.", "author": "Andrea" } }
      ]
    }
  ]
}
{% endschema %}
