<section class="vp-section" id="guias">
  <h2>{{ section.settings.heading | default: "Guías disponibles" }}</h2>
  <div class="vp-products">
    {% assign col = collections[section.settings.collection] | default: collections.all %}
    {% for product in col.products limit: section.settings.limit %}
      <article class="vp-product">
        <a href="{{ product.url }}">
          {% if product.featured_image %}
            <img src="{{ product.featured_image | image_url: width: 400 }}" alt="{{ product.title }}" class="vp-product-img" loading="lazy">
          {% else %}
            <div class="vp-product-placeholder"><span>{{ product.title | truncate: 40 }}</span></div>
          {% endif %}
          <div class="vp-product-body">
            <span class="vp-badge">PDF · Digital</span>
            <h3>{{ product.title }}</h3>
            <p class="vp-price">{{ product.price | money }}</p>
          </div>
        </a>
      </article>
    {% else %}
      <p class="vp-empty">Añade productos en Shopify Admin → Productos</p>
    {% endfor %}
  </div>
</section>
{% schema %}
{
  "name": "Productos destacados",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "Guías disponibles" },
    { "type": "collection", "id": "collection", "label": "Colección" },
    { "type": "range", "id": "limit", "min": 2, "max": 12, "step": 1, "default": 6, "label": "Máximo productos" }
  ]
}
{% endschema %}
