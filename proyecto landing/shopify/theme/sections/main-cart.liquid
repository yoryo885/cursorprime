<section class="vp-main-page">
  <h1>Carrito</h1>
  {% if cart.item_count > 0 %}
    <form action="{{ routes.cart_url }}" method="post">
      <table class="vp-cart-table">
        <thead>
          <tr><th>Producto</th><th>Cantidad</th><th>Total</th></tr>
        </thead>
        <tbody>
          {% for item in cart.items %}
            <tr>
              <td><a href="{{ item.url }}">{{ item.product.title }}</a></td>
              <td><input type="number" name="updates[]" value="{{ item.quantity }}" min="0" style="width:64px;padding:8px"/></td>
              <td>{{ item.line_price | money }}</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
      <p class="vp-cart-total">Total: {{ cart.total_price | money }}</p>
      <button type="submit" name="update" class="vp-btn vp-btn-outline" style="margin-right:12px">Actualizar</button>
      <button type="submit" name="checkout" class="vp-btn">Finalizar compra</button>
    </form>
  {% else %}
    <p style="color:var(--vp-muted);margin-bottom:24px">Tu carrito está vacío.</p>
    <a href="{{ routes.all_products_collection_url }}" class="vp-btn">Ver guías PDF</a>
  {% endif %}
</section>
{% schema %}
{
  "name": "Carrito",
  "settings": [],
  "templates": ["cart"]
}
{% endschema %}
