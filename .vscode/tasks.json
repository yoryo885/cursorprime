{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "openSimpleBrowser",
      "type": "command",
      "command": "simpleBrowser.show",
      "args": ["http://localhost:8768/tienda.html"]
    }
  ],
  "tasks": [
    {
      "label": "Vértice Pro: abrir en Browser",
      "dependsOrder": "sequence",
      "dependsOn": [
        "Vértice Pro: servir preview",
        "Vértice Pro: launch Simple Browser"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "Vértice Pro: servir preview",
      "type": "shell",
      "command": "python3 -m http.server 8768",
      "options": {
        "cwd": "${workspaceFolder}/vertice-pro-preview"
      },
      "isBackground": true,
      "problemMatcher": {
        "pattern": { "regexp": "^$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": ".",
          "endsPattern": "Serving HTTP"
        }
      },
      "presentation": {
        "reveal": "silent",
        "panel": "dedicated"
      }
    },
    {
      "label": "Vértice Pro: launch Simple Browser",
      "type": "shell",
      "command": "${input:openSimpleBrowser}",
      "presentation": {
        "reveal": "never",
        "panel": "shared",
        "close": true
      },
      "problemMatcher": []
    }
  ]
}
