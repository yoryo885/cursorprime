{
  "titulo": "Entrevista estándar — tienda / landing",
  "version": 2,
  "intro": "Siempre las mismas preguntas. Responde en una línea cada una (o 'auto' donde aplique).",
  "protocolo_chat": [
    "Si el usuario manda una idea de tienda web, landing, página de ventas o ecommerce → NO generar HTML aún.",
    "Hacer TODAS las preguntas de este archivo, numeradas, en un solo mensaje.",
    "En colores: proponer 3 paletas (A/B/C) según la idea + clima; marcar la recomendada.",
    "Cuando responda → guardar respuestas.json y generar preview."
  ],
  "preguntas": [
    {
      "id": "idea",
      "texto": "¿En una frase, qué tienda o landing quieres? (pega URL de referencia si hay)",
      "ejemplo": "Tienda de guías PDF por oficio, look tipo filjos.com",
      "obligatoria": true
    },
    {
      "id": "marca",
      "texto": "¿Nombre de la marca?",
      "ejemplo": "Vértice Pro",
      "obligatoria": true
    },
    {
      "id": "producto",
      "texto": "¿Qué vendes? (productos / colección)",
      "ejemplo": "Guías PDF libro × rol profesional",
      "obligatoria": true
    },
    {
      "id": "cliente",
      "texto": "¿Para quién es?",
      "ejemplo": "Profesionales por oficio (psicopedagogas, docentes…)",
      "obligatoria": true
    },
    {
      "id": "promesa",
      "texto": "¿Promesa de la marca (una línea)?",
      "ejemplo": "Ideas de libros aplicadas a tu rol — elige tu guía",
      "obligatoria": true
    },
    {
      "id": "catalogo",
      "texto": "¿Varios productos en la página? (si / no). Si sí, ¿cuáles o 'usar catálogo default'?",
      "ejemplo": "si — catálogo default libro×rol",
      "obligatoria": true
    },
    {
      "id": "cta",
      "texto": "¿Texto del botón principal?",
      "ejemplo": "Ver colección",
      "obligatoria": true
    },
    {
      "id": "precio",
      "texto": "¿Precio visible? (ej. desde $4.99 / oculto)",
      "ejemplo": "desde $4.99",
      "obligatoria": true
    },
    {
      "id": "tono",
      "texto": "¿Tono? (editorial | cercano | directo)",
      "ejemplo": "editorial",
      "obligatoria": true
    },
    {
      "id": "estilo",
      "texto": "¿Estilo de página? (editorial | tienda | mockup | oferta | auto)",
      "ejemplo": "tienda",
      "obligatoria": true,
      "notas": "tienda = colección tipo Filjós"
    },
    {
      "id": "clima_color",
      "texto": "¿Clima de color? (cálido | frío | neutro | oscuro | auto)",
      "ejemplo": "auto",
      "obligatoria": true
    },
    {
      "id": "paleta",
      "texto": "¿Paleta? (A | B | C | auto). El agente propone 3 al preguntar.",
      "ejemplo": "auto",
      "obligatoria": true
    },
    {
      "id": "referencia",
      "texto": "¿URL o marca de referencia visual? (o 'ninguna')",
      "ejemplo": "https://filjos.com/",
      "obligatoria": false
    },
    {
      "id": "extra",
      "texto": "¿Algo que NO puede faltar? (o 'nada')",
      "ejemplo": "filtros por rol + newsletter",
      "obligatoria": false
    }
  ],
  "paletas_preset": {
    "calido": {
      "A": { "nombre": "Papel arena", "ink": "#1a1510", "paper": "#f6f1e8", "accent": "#8b5a2b", "muted": "#8a7f72" },
      "B": { "nombre": "Oliva suave", "ink": "#1c1a14", "paper": "#f3efe6", "accent": "#5c6b4a", "muted": "#7d786c" },
      "C": { "nombre": "Terracota clara", "ink": "#171310", "paper": "#f7f2ec", "accent": "#a65d45", "muted": "#8b8278" }
    },
    "frio": {
      "A": { "nombre": "Pizarra", "ink": "#12151a", "paper": "#f2f4f6", "accent": "#3d5a73", "muted": "#6f7882" },
      "B": { "nombre": "Hielo", "ink": "#0f1419", "paper": "#eef2f5", "accent": "#2f6f7e", "muted": "#6a737c" },
      "C": { "nombre": "Noche clara", "ink": "#101820", "paper": "#f0f3f7", "accent": "#264653", "muted": "#6b7280" }
    },
    "neutro": {
      "A": { "nombre": "Editorial", "ink": "#0f1419", "paper": "#f7f4ef", "accent": "#1a1a1a", "muted": "#8a847c" },
      "B": { "nombre": "Galería", "ink": "#14110f", "paper": "#faf6f0", "accent": "#2a2520", "muted": "#6a635c" },
      "C": { "nombre": "Lino", "ink": "#161412", "paper": "#f5f2ec", "accent": "#3a342c", "muted": "#7a746c" }
    },
    "oscuro": {
      "A": { "nombre": "Carbón", "ink": "#f4f0ea", "paper": "#12151a", "accent": "#d4c4a8", "muted": "#9a948a" },
      "B": { "nombre": "Tinta", "ink": "#f2efe8", "paper": "#0e1114", "accent": "#c4b5a0", "muted": "#8e8780" },
      "C": { "nombre": "Graphite", "ink": "#f5f3ef", "paper": "#16181c", "accent": "#e8e0d4", "muted": "#a39e96" }
    }
  },
  "recomendacion_default": {
    "clima_si_auto": "neutro",
    "paleta_si_auto": "A",
    "estilo_si_auto": "tienda"
  }
}
