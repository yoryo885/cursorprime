MOCK_GENERATE=true
MOCK_KLING=true
MOCK_LLM=true
CHECKPOINT=true
DEFAULT_SLUG=demo_lote

# Copy LLM (Paso C)
# MOCK_LLM=false
# ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-20250514

# Imágenes IA (Paso D)
# IMAGE_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_IMAGE_MODEL=dall-e-3
# REPLICATE_API_TOKEN=

# Kling real (Paso E) — MOCK_KLING=false
# KIE_API_KEY=
# KIE_API_URL=https://api.kie.ai/api/v1/jobs/createTask
# KIE_KLING_MODEL=kling-2.6/image-to-video
# KIE_DURATION=5
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# CLOUDINARY_UPLOAD_PRESET=  # opcional unsigned

# Voz TTS — ElevenLabs (capítulo ancla + cortes)
# Archivo: creador de contenido/.env  (NO subir al repo)
# TTS_PROVIDER=elevenlabs
# MOCK_TTS=false
# ELEVENLABS_API_KEY=sk_xxxxxxxx
# ELEVENLABS_VOICE_ID=          # opcional: ID de la voz en tu cuenta
# ELEVENLABS_MODEL_ID=eleven_multilingual_v2
